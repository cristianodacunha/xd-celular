:root { color-scheme: dark; font-family: Arial, sans-serif; background: #070b14; }
* { box-sizing: border-box; }
[hidden] { display: none !important; }
body { margin: 0; min-height: 100dvh; }
.login-shell { min-height: 100dvh; display: grid; place-items: center; padding: 24px; overflow: hidden; position: relative; }
.intro-video, .veil { inset: 0; height: 100%; position: fixed; width: 100%; }
.intro-video { object-fit: cover; opacity: .34; }
.veil { background: radial-gradient(circle at 50% 20%, #20335399, #070b14 72%); }
.login-card { background: #101827e8; border: 1px solid #ffffff1f; border-radius: 28px; box-shadow: 0 20px 70px #000a; max-width: 420px; padding: 30px 24px; position: relative; text-align: center; width: 100%; }
.helmet { height: 94px; object-fit: contain; width: 112px; }
.eyebrow { color: #80c7ff; font-size: .72rem; font-weight: 700; letter-spacing: .16em; margin: 8px 0; }
h1 { font-size: clamp(1.7rem, 7vw, 2.25rem); line-height: 1.05; margin: 8px 0 14px; }
.subtitle, .status { color: #b7c3d5; font-size: .92rem; line-height: 1.45; }
form { display: grid; gap: 13px; margin-top: 22px; text-align: left; }
label { color: #dce6f6; display: grid; font-size: .82rem; font-weight: 700; gap: 7px; }
input { background: #070d18; border: 1px solid #40516a; border-radius: 12px; color: #fff; font: inherit; padding: 14px; width: 100%; }
button { border: 0; border-radius: 12px; cursor: pointer; font: inherit; font-weight: 700; padding: 15px; }
form button { background: #59b9ff; color: #06111f; margin-top: 4px; }
.link { color: #91d2ff; display: inline-block; font-size: .84rem; margin-top: 15px; padding: 8px; text-decoration: none; }
.first-access { background: #14243a; border: 1px solid #69c8ff; border-radius: 10px; color: #9ad9ff; display: inline-flex; font-size: .82rem; font-weight: 700; justify-content: center; margin-top: 15px; padding: 10px 14px; text-decoration: none; }
.install { background: #2ed39a; color: #042218; margin-top: 10px; width: 100%; }
.status { font-size: .78rem; margin: 8px 0 0; }
.status[data-status="error"] { color: #facc15; }
.app-menu { display: grid; gap: 10px; margin-top: 20px; text-align: left; }
.app-menu .eyebrow { margin: 0 0 2px; text-align: center; }
.catalog-shortcut { align-items: center; border: 1px solid #ffffff22; border-radius: 14px; color: #f6f9ff; display: flex; font-weight: 700; justify-content: space-between; padding: 16px; text-decoration: none; }
.catalog-shortcut span { font-size: 1.5rem; line-height: .7; }
.catalog-shortcut.honda { background: #9e1220; }
.catalog-shortcut.yamaha { background: #0b4c91; }
.catalog-shortcut.xd { background: #334155; }
.remove { background: transparent; border: 1px solid #ef6d76; border-radius: 12px; color: #ff9ba1; margin-top: 4px; padding: 11px; }
.installed-notice { background: #081322; display: grid; inset: 0; min-height: 100dvh; padding: 42px 28px; place-content: center; position: fixed; text-align: center; z-index: 10; }
.installed-notice img { height: 110px; object-fit: contain; width: 130px; }
.installed-notice h2 { font-size: 2rem; margin: 20px 0 10px; }
.installed-notice p { color: #c4d3e8; line-height: 1.5; margin: 0 auto 24px; max-width: 330px; }
.installed-notice button { background: #59b9ff; color: #06111f; min-width: 180px; }
.ios-install-guide { background: #081322; display: grid; inset: 0; min-height: 100dvh; padding: 36px 28px; place-content: center; position: fixed; text-align: left; z-index: 11; }
.ios-install-guide img { display: block; height: 90px; margin: 0 auto 12px; object-fit: contain; width: 110px; }
.ios-install-guide h2 { font-size: 1.8rem; margin: 8px 0 22px; text-align: center; }
.ios-install-guide p { background: #14243a; border: 1px solid #ffffff1f; border-radius: 12px; color: #dce6f6; line-height: 1.45; margin: 0 0 10px; padding: 14px; }
.ios-install-guide p b { color: #69c8ff; font-size: 1.15rem; }
.ios-install-guide button { background: #59b9ff; color: #06111f; margin-top: 12px; }

/* Menu alinhado ao visual do Catalogo XD do site. */
:root { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; background: #0f172a; }
.veil { background: radial-gradient(circle at 50% 10%, #27364d99, #0f172a 72%); }
.login-card { background: #0f172af2; border-color: #334155; border-radius: 20px; box-shadow: 0 24px 80px #000c; }
.helmet { filter: drop-shadow(0 10px 22px #0008); }
.eyebrow { color: #f97316; }
h1 { color: #f8fafc; }
.subtitle, .status { color: #94a3b8; }
input { background: #111827; border-color: #475569; border-radius: 10px; }
input:focus { border-color: #f97316; outline: 3px solid #f9731625; }
form button, .installed-notice button, .ios-install-guide button { background: #ea580c; color: #fff; }
.first-access { background: #1e293b; border-color: #475569; color: #cbd5e1; }
.install { background: #ea580c; color: #fff; }
.app-menu { gap: 12px; }
.catalog-shortcut.xd { min-height: 94px; background: linear-gradient(135deg,#1e293b,#172033); border: 1px solid #475569; border-left: 4px solid #f97316; box-shadow: 0 12px 28px #0004; padding: 18px; }
.catalog-shortcut.xd:active { transform: scale(.985); border-color: #f97316; }
.catalog-copy { display: grid; gap: 5px; min-width: 0; }
.catalog-copy b { color: #f8fafc; font-size: 1.14rem; }
.catalog-copy small { color: #94a3b8; font-size: .76rem; font-weight: 500; line-height: 1.35; }
.catalog-arrow { color: #f97316; font-size: 2rem !important; }
.link { color: #fb923c; }
.remove { border-color: #7f1d1d; color: #fca5a5; }
.installed-notice, .ios-install-guide { background: #0f172a; }
.ios-install-guide p { background: #1e293b; border-color: #334155; }
.ios-install-guide p b { color: #fb923c; }
